<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ethernetip_generic_io_driver</name>
  <version>0.1.0</version>
  <description>
    Generic EtherNet/IP assembly‑mapping device driver.
    Automatically maps YAML field definitions into ros2_control state and
    command interfaces.  Works with any device that exposes simple IO
    assemblies (PLC IO, POINT IO, analog modules, etc.).
  </description>
  <maintainer email="todo@todo.com">TODO</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>pluginlib</depend>
  <depend>hardware_interface</depend>
  <depend>ethernetip_master</depend>
  <depend>ethernetip_device_driver_interface</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
