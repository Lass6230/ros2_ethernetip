<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ros2_ethernetip</name>
  <version>0.1.0</version>
  <description>
    Metapackage for the ros2_ethernetip stack – a generic ros2_control
    hardware interface for EtherNet/IP devices using EIPScanner.
  </description>
  <maintainer email="todo@todo.com">TODO</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>ethernetip_master</exec_depend>
  <exec_depend>ethernetip_device_driver_interface</exec_depend>
  <exec_depend>ethernetip_hardware_interface</exec_depend>
  <exec_depend>ethernetip_generic_io_driver</exec_depend>
  <exec_depend>ethernetip_description</exec_depend>
  <exec_depend>ethernetip_demos</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
